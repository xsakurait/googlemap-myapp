{
  // markdownlint 設定（日本語ドキュメント向けに一部ルールを緩和）
  "config": {
    "default": true,
    // 行の長さ制限は日本語文書に合わないため無効
    "MD013": false,
    // 同一見出しは兄弟レベルの範囲でのみ禁止
    "MD024": { "siblings_only": true },
    // 番号付きリストの表記ゆれ（1b. 等）を許容
    "MD029": false,
    // インラインHTMLを許容
    "MD033": false,
    // 強調だけの行（見出し代わり）を許容
    "MD036": false,
    // コードブロックの言語指定は任意
    "MD040": false,
    // テーブル区切り行のスペース有無（|---| 形式）を許容
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", ".git/**"]
}
