# 環境変数のサンプルファイル。
# このファイルをコピーして .env.local を作り、値を入れてください。
#   Windows: copy .env.sample .env.local
#   Mac/Linux: cp .env.sample .env.local
# .env.local は .gitignore 済みで Git には上がりません。キーはチャット等に貼らないこと。

# Google Maps Platform の APIキー（Routes API のみ許可したキー）
GOOGLE_MAPS_API_KEY=

# キー無し開発時にモック応答を使う場合は 1 を設定する
TRA_USE_MOCK=

# --- 交通手段の拡張用（未使用。docs/00_要件定義書.md §10 の取得元が確定したら有効化する） ---
# ODPT_ACCESS_TOKEN=
# AVIATIONSTACK_API_KEY=
# SERPAPI_API_KEY=
